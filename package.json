{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "Full-stack expense tracker: income/expense tracking, accounts, receipts, charts, multi-currency, dark mode, PWA.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node tests/run.js",
    "dev:cf": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "tunnel": "npx cloudflared tunnel --url http://localhost:3000",
    "auth:reset": "node scripts/reset-lock.js",
    "icons": "node scripts/gen-icons.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17"
  }
}
